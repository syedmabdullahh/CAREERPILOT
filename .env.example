# CareerPilot AI Configuration
# Copy this file to .env and adjust variables as needed

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# AI / LLM Configuration
# Supports Qwen 2.5, OpenAI, DeepSeek, or local Ollama
LLM_PROVIDER=qwen
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=your_api_key_here
LLM_API_BASE_URL=https://api.together.xyz/v1

# Agent Execution Parameters
AGENT_TIMEOUT_SECONDS=45
MAX_RESUME_TOKENS=4000
ENABLE_PARALLEL_EXECUTION=True
ENABLE_STREAMING=True

# Database Configuration
# PostgreSQL (Production / Cloud): postgresql://username:password@localhost:5432/careerpilot
# Leave blank to use instant zero-config SQLite (./storage/careerpilot.db)
DATABASE_URL=

# Cache & Storage
CACHE_ENABLED=True
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=10

# Market Localization
DEFAULT_REGION=Pakistan
CURRENCY=PKR
